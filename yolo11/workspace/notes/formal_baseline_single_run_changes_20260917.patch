+def check_validation_finite(validator):
+    """Fail before official NaN recovery; never retry or change precision/settings."""
+    import torch
+    losses = getattr(validator, 'loss', None)
+    if isinstance(losses, dict):
+        require(all(bool(torch.isfinite(v).all()) for v in losses.values()),
+                '验证 loss 出现 NaN/Inf；停止，不执行自动恢复或最终 test。')
+    metrics = getattr(getattr(validator, 'metrics', None), 'results_dict', {})
+    require(all(math.isfinite(float(v)) for v in metrics.values()), '验证指标出现 NaN/Inf。')
+
