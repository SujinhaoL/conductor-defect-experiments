+"""Summarize all three completed seeds without loading a model or using test."""
+from __future__ import annotations
+import sys
+sys.dont_write_bytecode = True
+
+import csv
+import io
+import json
+import math
+from pathlib import Path
+import statistics
+import yaml
+
+from run_formal_baseline import (
+    EXPERIMENTS, PROTOCOL, REGISTRY, RUNS, RUN_LOCK, WORKSPACE,
+    configure_process, load_reference, require, assert_protocol_diff,
+    read_results, result_summary, sha256, exclusive_lock,
+)
+
+FIELDS = [
+    'precision_at_best_epoch', 'recall_at_best_epoch', 'map50_at_best_epoch', 'map50_95_at_best_epoch',
+    'broken_map50', 'broken_map50_95', 'loose_map50', 'loose_map50_95',
+    'best_epoch', 'runtime_seconds', 'peak_vram_mib',
+]
+
+
+def calculate_statistics(individual):
+    require(len(individual) == 3, '必须恰有三个 individual runs。')
+    require({r['experiment_id']: r['seed'] for r in individual} == EXPERIMENTS, '三 seed 白名单不完整或重复。')
+    stats = {}
+    for field in FIELDS:
+        values = [r[field] for r in individual]
+        require(all(isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)
+                    for v in values), f'{field} 缺少可靠数值；不忽略缺失 seed，不用零代替 NA。')
+        mean, std = statistics.mean(values), statistics.stdev(values)  # sample SD, ddof=1
+        stats[field] = {'n': 3, 'mean': mean, 'sample_std_ddof1': std, 'mean_plus_minus_std': f'{mean:.6f} ± {std:.6f}'}
+    return stats
+
+
+def collect_completed(protocol):
+    reference, _, _, records, _ = load_reference(protocol)
+    by_id = {r['experiment_id']: r for _, r in records}
+    missing = [key for key in EXPERIMENTS if key not in by_id or by_id[key]['status'] != 'Completed']
+    require(not missing, f'正式汇总尚不可生成；以下实验缺失或未 Completed：{missing}')
+    individual = []
+    for experiment_id, seed in EXPERIMENTS.items():
+        row = by_id[experiment_id]
+        require(row['stage'] == 'FormalBaseline' and row['seed'] == seed and row['test_used'] is False
+                and row['include_in_paper'] == 'Candidate', f'登记身份不一致：{experiment_id}')
+        run = Path(row['run_directory']).resolve()
+        require(run.parent == RUNS.resolve() and run.name.startswith(experiment_id + '_'), 'run 路径不是本实验的新目录。')
+        status_path = WORKSPACE / 'logs' / run.name / 'status.json'
+        status = json.loads(status_path.read_text(encoding='utf-8'))
+        require(status['experiment_id'] == experiment_id and status['seed'] == seed
+                and status['success'] is True and status['state'] == 'Completed'
+                and status['training_completed'] is True and status['registry_synchronized'] is True
+                and status['test_used'] is False and status['dry_run'] is False, f'运行 status 不完整：{experiment_id}')
+        require(status['preflight']['protocol_sha256'] == sha256(PROTOCOL), '运行使用的协议与当前冻结协议不同。')
+        require(status['preflight']['pretrained_sha256'] == protocol['weights']['sha256'], '预训练权重不同。')
+        require(status['preflight']['dataset_integrity']['unchanged'] is True
+                and status['dataset_integrity_after']['unchanged'] is True
+                and not status['blocked_dataset_writes'], '数据完整性检查未完整通过。')
+        require(status['git_after']['commit'] == protocol['environment']['git_commit'] and not status['git_after']['status'],
+                '训练后源码不符合协议。')
+        for name in ('args.yaml', 'results.csv', 'weights/best.pt', 'weights/last.pt'):
+            require(sha256(run / name) == status['artifact_sha256'][name], f'训练后产物发生变化：{run / name}')
+        saved_args = yaml.safe_load((run / 'args.yaml').read_text(encoding='utf-8-sig'))
+        assert_protocol_diff(reference, saved_args, experiment_id)
+        calculated = result_summary(read_results(run / 'results.csv', reference['epochs']))
+        for key, value in calculated.items():
+            require(row[key] == value and status['best_epoch_metrics'][key] == value, f'登记/状态/CSV 不一致：{experiment_id}.{key}')
+        for key in FIELDS:
+            if key in calculated:
+                continue
+            evidence = status['per_class_metrics'].get(key, status.get(key))
+            require(row[key] == evidence, f'登记/状态不一致：{experiment_id}.{key}')
+        individual.append({'experiment_id': experiment_id, 'seed': seed,
+                           **{key: row[key] for key in FIELDS}, 'run_directory': str(run), 'status_json': str(status_path)})
+    return individual
+
+
+def render_outputs(individual, stats, protocol):
+    columns = ['row_type', 'experiment_id', 'seed', *FIELDS]
+    stream = io.StringIO(newline='')
+    writer = csv.DictWriter(stream, fieldnames=columns)
+    writer.writeheader()
+    for row in individual:
+        writer.writerow({'row_type': 'individual', **{k: row[k] for k in columns[1:]}})
+    for kind, stat_key in [('mean', 'mean'), ('sample_std_ddof1', 'sample_std_ddof1'), ('mean_plus_minus_std', 'mean_plus_minus_std')]:
+        writer.writerow({'row_type': kind, **{k: stats[k][stat_key] for k in FIELDS}})
+    payload = {'protocol_sha256': sha256(PROTOCOL), 'reference_experiment': 'Y11-DIAG-001',
+               'stage': 'FormalBaseline', 'test_used': False, 'n': 3, 'ddof': 1,
+               'metric_basis': 'overall P/R/AP from same best epoch; class AP from separate fixed val revalidation',
+               'runtime_basis': 'new-run setup, training, val revalidation and dataset postflight; seconds',
+               'peak_vram_basis': 'PyTorch allocated peak during model.train(); MiB, excludes separate val revalidation',
+               'individual_runs': individual, 'statistics': stats}
+    lines = ['# 官方 YOLO11s FormalBaseline 三 seed 汇总', '',
+             '三个 individual runs 全部保留；总体成绩使用 mean ± sample standard deviation（ddof=1）。',
+             '不选择最高 seed 替代正式基线成绩。test 未用于模型评价。', '',
+             '| experiment ID | seed | best epoch | P | R | mAP50 | mAP50-95 | runtime (s) | peak VRAM (MiB) |',
+             '|---|---:|---:|---:|---:|---:|---:|---:|---:|']
+    for row in individual:
+        lines.append(f"| {row['experiment_id']} | {row['seed']} | {row['best_epoch']} | "
+                     + ' | '.join(f'{row[k]:.6f}' for k in FIELDS[:4])
+                     + f" | {row['runtime_seconds']:.2f} | {row['peak_vram_mib']:.2f} |")
+    lines += ['', '| metric | seed 42 | seed 3407 | seed 2026 | mean ± sample std |', '|---|---:|---:|---:|---|']
+    for field in FIELDS:
+        lines.append('| ' + field + ' | ' + ' | '.join(f'{r[field]:.6f}' for r in individual)
+                     + ' | ' + stats[field]['mean_plus_minus_std'] + ' |')
+    lines += ['', '整体 P/R/AP 取每个 run 的同一 best epoch；best 先按 mAP50-95、并列再按 mAP50，完全并列取最早轮次。',
+              'broken/loose AP 来自该 run 的 best.pt 固定 val 复验，不能与训练期间整体 AP 混作同一次测量。',
+              'runtime_seconds 包含新 run 设置、训练、val 复验与数据完整性后检查；peak VRAM 为 model.train() 阶段 PyTorch allocated 峰值。',
+              'best epoch、runtime 和 VRAM 的 mean/std 仅为描述统计。所有 AP 值范围为 0–1。', '', '证据：']
+    for row in individual:
+        lines.append(f"- {row['experiment_id']}: `{row['run_directory']}`；status: `{row['status_json']}`")
+    return stream.getvalue(), json.dumps(payload, ensure_ascii=False, indent=2, allow_nan=False) + '\n', '\n'.join(lines) + '\n'
+
+
+def main():
+    configure_process()
+    try:
+        with exclusive_lock(RUN_LOCK, {'operation': 'summary; no model calls'}):
+            protocol = yaml.safe_load(PROTOCOL.read_text(encoding='utf-8-sig'))
+            individual = collect_completed(protocol)
+            stats = calculate_statistics(individual)
+            outputs = render_outputs(individual, stats, protocol)
+            paths = [WORKSPACE / 'analysis/formal_baseline_3seed_summary.csv',
+                     WORKSPACE / 'analysis/formal_baseline_3seed_metrics.json',
+                     WORKSPACE / 'notes/formal_baseline_3seed_report.md']
+            # Validate every existing destination before writing any new output.
+            for path, content in zip(paths, outputs):
+                if path.exists():
+                    require(path.read_text(encoding='utf-8-sig') == content, f'已有汇总内容不同，拒绝覆盖：{path}')
+            for path, content in zip(paths, outputs):
+                if not path.exists():
+                    with path.open('x', encoding='utf-8-sig' if path.suffix == '.csv' else 'utf-8', newline='') as stream:
+                        stream.write(content)
+                print(path)
+        return 0
+    except (RuntimeError, OSError, KeyError, ValueError) as exc:
+        print(f'停止汇总：{exc}', file=sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
